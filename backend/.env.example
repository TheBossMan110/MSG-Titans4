# ══════════════════════════════════════════════════════════════
# SupportNova — environment template.  Copy to .env and fill in.
# NEVER commit the real .env file.
# ══════════════════════════════════════════════════════════════

# ── application ──────────────────────────────────────────────
APP_ENV=development                  # development | production
APP_NAME=SupportNova
API_PREFIX=/api
LOG_LEVEL=INFO
SECRET_ROTATION_NOTE=generate JWT_SECRET with: openssl rand -hex 32

# ── database ─────────────────────────────────────────────────
# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler"
# Replace 'postgresql://' with 'postgresql+psycopg://'
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Offline/demo fallback:
# DATABASE_URL=sqlite:///./supportnova.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false

# ── file storage ─────────────────────────────────────────────
STORAGE_BACKEND=local                # local | supabase
STORAGE_LOCAL_DIR=./var/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# ── auth ─────────────────────────────────────────────────────
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=120
REFRESH_TOKEN_DAYS=7

# ── generative ai providers (free tiers) ─────────────────────
LLM_PRIMARY_PROVIDER=gemini          # gemini | groq | openrouter
LLM_FALLBACK_PROVIDER=groq
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_CACHE_ENABLED=true
LLM_TEMPERATURE_INTELLIGENCE=0.1
LLM_TEMPERATURE_RESPONSE=0.4

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2:free,nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── embeddings / retrieval ───────────────────────────────────
EMBEDDING_ENABLED=true
EMBEDDING_DIM=768                    # gemini-embedding-001 reduced from 3072.
                                     # Changing this = re-embed every chunk.
RETRIEVAL_TOP_K=8
CHUNK_TOKENS=800
CHUNK_OVERLAP=120

# ── pipeline thresholds ──────────────────────────────────────
DUPLICATE_SIMILARITY_THRESHOLD=0.85
NEAR_DUPLICATE_THRESHOLD=0.70
HALLUCINATION_OVERLAP_THRESHOLD=0.35
MIN_COMPLAINT_LENGTH=20
MAX_COMPLAINT_LENGTH=8000
MAX_UPLOAD_MB=10

# ── cors (frontend origins) ──────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── rate limiting ────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DEFAULT=120/minute

# ── dataset ───────────────────────────────────────────────
# The corpus is a sibling of backend/, so the default resolves to
# ../dataset and needs no setting locally. Set it explicitly in a
# container, where backend/ is the image root and the sibling does not
# exist unless it was copied in.
# DATASET_DIR=/app/dataset
DATASET_DOMAINS=ecommerce,logistics

# DeepSeek (optional, pay-per-use: NOT free). Leave empty to keep the chain free.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Email channel
EMAIL_ADDRESS=supportnova@gmail.com
EMAIL_APP_PASSWORD=
PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM=
