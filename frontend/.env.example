# Copy to .env.local. Nothing here is a secret: the frontend holds no keys.
#
# Where the browser reaches the FastAPI backend (must be in the backend's CORS_ORIGINS list).
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Where the Next.js server reaches the backend for the session proxy (login / refresh / logout).
# Defaults to NEXT_PUBLIC_API_URL; set separately when the server sees the backend on another host (docker, etc.).
# API_URL=http://backend:8000
#
# Server-only (never NEXT_PUBLIC_): the same value as SESSION_PROXY_SECRET in the backend's .env.
# Lets the backend rate-limit sign-ins per visitor even though they all arrive from the proxy.
# SESSION_PROXY_SECRET=
